APP_NAME=CashPilot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cashpilot.mohiebi.com
ADMIN_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────────
# Connects to the shared portfolio-mariadb container via portfolio-net.
# Create the database first:
#   docker exec portfolio-mariadb mariadb -u root -p'ROOT_PASS' \
#     -e "CREATE DATABASE IF NOT EXISTS cashpilot_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#         CREATE USER IF NOT EXISTS 'cashpilot'@'%' IDENTIFIED BY 'DB_PASS';
#         GRANT ALL PRIVILEGES ON cashpilot_db.* TO 'cashpilot'@'%';
#         FLUSH PRIVILEGES;"
DB_CONNECTION=mysql
DB_HOST=portfolio-mariadb
DB_PORT=3306
DB_DATABASE=cashpilot_db
DB_USERNAME=cashpilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail (Resend) ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx   # or set RESEND_KEY — both are accepted
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@cashpilot.mohiebi.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
GOOGLE_SITE_VERIFICATION=

# ── Telegram bot ───────────────────────────────────────────────────────────────
TELEGRAPH_STORAGE_DRIVER=cache
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Asset prices ───────────────────────────────────────────────────────────────
TGJU_PRICES_ENABLED=true
TGJU_PRICE_CACHE_SECONDS=300

# ── AI portfolio advisor ───────────────────────────────────────────────────────
# These credentials are server-side only. Never expose the API key through a
# VITE_ variable or send it to the browser.
ADVISOR_AI_PROVIDER=openai
ADVISOR_AI_MODEL=gpt-5-mini
ADVISOR_AI_TIMEOUT=300
ADVISOR_AI_EXECUTION_TIME_BUFFER=15
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1

# ── Miles packs (crypto) ───────────────────────────────────────────────────────
# BILLING_ENABLED shows the page that sells Miles. It needs BILLING_EVM_ADDRESS
# and at least one chain switched on to be usable: with none, the checkout opens
# with no network to pay on. Leave BILLING_ETHEREUM_ENABLED false until the
# contract addresses below have been checked against Etherscan. A wrong contract
# rejects every payment in that asset.
BILLING_ENABLED=false
BILLING_PRICE_MONTHLY=5.00
BILLING_PRICE_QUARTERLY=13.00
BILLING_PRICE_YEARLY=45.00

# One receiving address serves every EVM chain.
BILLING_EVM_ADDRESS=

BILLING_ETHEREUM_ENABLED=false
BILLING_ETHEREUM_RPC_URL=
BILLING_ETHEREUM_CONFIRMATIONS=12
BILLING_ETHEREUM_USDT_CONTRACT=0xdac17f958d2ee523a2206206994597c13d831ec7
BILLING_ETHEREUM_USDC_CONTRACT=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48

# Arbitrum One. Same receiving address, same Etherscan key — only the chain
# differs. Fees are cents rather than dollars, which matters a great deal when
# the monthly plan is $5. Verify both contracts on arbiscan.io first: they are
# not the Ethereum ones, and USDC has a second bridged version (USDC.e) that is
# a different token entirely.
BILLING_ARBITRUM_ENABLED=false
BILLING_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BILLING_ARBITRUM_CONFIRMATIONS=20
BILLING_ARBITRUM_USDT_CONTRACT=0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9
BILLING_ARBITRUM_USDC_CONTRACT=0xaf88d065e77c8cc2239327c5edb3a432268e5831

# Optional, and worth having. Lets ether forwarded by a contract — which most
# exchange withdrawals are — settle automatically instead of waiting for a human,
# and stands in as a second endpoint when the RPC node above is unreachable.
# One key covers every supported chain. Free tier: https://etherscan.io/apis
BILLING_ETHERSCAN_ENABLED=false
BILLING_ETHERSCAN_API_KEY=

BILLING_QUOTE_ENABLED=true
BILLING_QUOTE_CACHE_SECONDS=300
BILLING_QUOTE_LOCK_MINUTES=30
BILLING_PAYMENT_WINDOW_HOURS=24
BILLING_TX_MAX_AGE_HOURS=72
BILLING_EXPIRY_WARNING_DAYS=7

# Temporary instrumentation for the post-OAuth SSR/hydration investigation.
# Ships browser-side hydration mismatches and JS errors to the server log, and
# records whether SSR markup reached each full-document render. Both land in
# `docker logs cashpilot-app`. Set to false once the cause is found.
CLIENT_DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_LOG_DOCUMENT_RENDERS=true

INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_URL=http://127.0.0.1:13714

VITE_APP_NAME="${APP_NAME}"
