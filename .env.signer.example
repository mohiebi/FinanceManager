PORT=8080
KEY_VERSION=v1
KEYSTORE_PATH=/data/keystore.json
OPERATIONS_PATH=/operations/operations.json
HMAC_SECRET_FILE=/run/secrets/wallet_signer_hmac

# A network with no endpoints or no vault is simply one this signer will refuse
# to settle on, so running a single chain does not mean inventing values for the
# other.
ETHEREUM_RPC_URLS=
ARBITRUM_RPC_URLS=https://arb1.arbitrum.io/rpc
ETHEREUM_SAFE_VAULT_ADDRESS=
ARBITRUM_SAFE_VAULT_ADDRESS=

# Where flagged funds an administrator accepted, and recovered funds nothing
# ever screened, are swept. Both are mandatory and must differ from the main
# vault; flagged settlements and recoveries are refused otherwise.
ETHEREUM_RISK_VAULT_ADDRESS=
ARBITRUM_RISK_VAULT_ADDRESS=

# How long one broadcast may wait for its receipt. Operations run one at a time
# so nonces stay ordered, which makes an unbounded wait every settlement stuck
# behind one.
CONFIRMATION_TIMEOUT_SECONDS=120

ARBITRUM_WETH_ADDRESS=0x82af49447d8a07e3bd95bd0d56f35241523fbab1
ARBITRUM_USDT_ADDRESS=0xfd086bc7cd5c481dcc9c85ebe478a1c0b69fcbb9
ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cc2239327c5edb3a432268e5831
ARBITRUM_UNISWAP_ROUTER_ADDRESS=
ARBITRUM_UNISWAP_QUOTER_ADDRESS=
ARBITRUM_ETH_USD_FEED=
ARBITRUM_USDT_USD_FEED=
ARBITRUM_USDC_USD_FEED=
UNISWAP_FEE_TIERS=100,500,3000

GAS_BUFFER_PERCENT=25
MAX_SLIPPAGE_BPS=100
MAX_PRICE_DEVIATION_BPS=200
QUOTE_LIFETIME_SECONDS=60
MAX_GAS_TOPUP_WEI=3000000000000000
MAX_HOURLY_GAS_WEI=10000000000000000
MAX_DAILY_GAS_WEI=50000000000000000
MAX_REMAINING_NATIVE_WEI=10000000000000
