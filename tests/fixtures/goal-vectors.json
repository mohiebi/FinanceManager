                "q0": 0,
                "qNow": 4.5,
                "qT": 3,
                "elapsed": 100,
                "total": 180
            },
            "expected": {
                "progress": 1.5,
                "expected_quantity": 1.666667,
                "pace_delta": 2.833333,
                "on_track": true,
                "reached": true,
                "required_per_day": 0,
                "days_remaining": 80
            }
        },
        {
            "name": "the target date has passed",
            "input": {
                "q0": 0,
                "qNow": 2,
                "qT": 3,
                "elapsed": 180,
                "total": 180
