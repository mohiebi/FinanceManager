{
    "_comment": "Shared by BuildGoalProgressTest (PHP) and tests/js/goals.test.ts. Under the vault the target quantity and the holdings are both ciphertext, so goal progress is computed in the browser instead of on the server; this fixture is what stops the two implementations drifting apart. Every value is rounded to 6 decimals on both sides.",
    "_encoding_comment": "How a sealed target quantity is serialised before encryption. The browser (codec.ts `encode`, type 'quantity') and the server (UserEncrypted::encode with ':decimal,8') must produce byte-identical strings, or an armed user's target is stored at a different precision from an unarmed one's. Values sitting exactly on a rounding boundary (1.845 at 2dp) are deliberately absent: PHP rounds half up and JS toFixed follows the binary representation down, which is a real but pre-existing divergence in the 'decimal' type and not something this feature should quietly change.",
    "encoding": [
        {
            "value": 3,
            "quantity": "3.00000000",
            "decimal": "3.00"
        },
        {
            "value": 1.845,
            "quantity": "1.84500000"
        },
        {
            "value": 0.00012345,
            "quantity": "0.00012345",
            "_note": "the case that motivated the 8dp type — 2dp seals this as 0.00",
            "decimal": "0.00"
        },
        {
            "value": 0.123456789,
            "quantity": "0.12345679",
            "decimal": "0.12"
        }
    ],
    "cases": [
        {
            "name": "on pace toward three grams of gold",
            "input": {
                "q0": 0,
                "qNow": 1.84,
                "qT": 3,
                "elapsed": 100,
                "total": 180
            },
            "expected": {
                "progress": 0.613333,
                "expected_quantity": 1.666667,
                "pace_delta": 0.173333,
                "on_track": true,
                "reached": false,
                "required_per_day": 0.0145,
                "days_remaining": 80
            }
        },
        {
            "name": "behind pace",
            "input": {
                "q0": 0,
                "qNow": 0.5,
                "qT": 3,
                "elapsed": 100,
                "total": 180
            },
            "expected": {
                "progress": 0.166667,
                "expected_quantity": 1.666667,
                "pace_delta": -1.166667,
                "on_track": false,
                "reached": false,
                "required_per_day": 0.03125,
                "days_remaining": 80
            }
        },
        {
            "name": "a non-zero baseline is not counted as progress the user just made",
            "input": {
                "q0": 1.5,
                "qNow": 1.84,
                "qT": 3,
                "elapsed": 100,
                "total": 180
            },
            "expected": {
                "progress": 0.613333,
                "expected_quantity": 2.333333,
                "pace_delta": -0.493333,
                "on_track": false,
                "reached": false,
                "required_per_day": 0.0145,
                "days_remaining": 80
            }
        },
        {
            "name": "goal set for today divides by zero unless guarded",
            "input": {
                "q0": 0,
                "qNow": 1,
                "qT": 3,
                "elapsed": 0,
                "total": 0
            },
            "expected": {
                "progress": 0.333333,
                "expected_quantity": 3,
                "pace_delta": -2,
                "on_track": false,
                "reached": false,
                "required_per_day": 2,
                "days_remaining": 0
            }
        },
        {
            "name": "an asset the user holds none of reads as zero, never as unavailable",
            "input": {
                "q0": 0,
                "qNow": 0,
                "qT": 3,
                "elapsed": 10,
                "total": 180
            },
            "expected": {
                "progress": 0,
                "expected_quantity": 0.166667,
                "pace_delta": -0.166667,
                "on_track": false,
                "reached": false,
                "required_per_day": 0.017647,
                "days_remaining": 170
            }
        },
        {
            "name": "past the target, progress goes over one rather than clamping",
